{"suite": "fixture", "fixture": true, "description": "Synthetic c3_shell outputs: minified bundles, buried test failures, compiler error walls, progress bars, JSONL, binary, ANSI, huge stderr, timeouts. Every case is a seeded generator in tests/shell_eval/generators.py; checks name the fragments the agent must still be able to read.", "default_max_bytes": 18432}
{"id": "minified_grep_hit", "cmd": "grep -n __c3_needle_7f3a__ dist/bundle.js", "generator": "minified_grep_hit", "params": {"lines": 3, "line_bytes": 300000, "token": "__c3_needle_7f3a__", "token_line": 1, "token_pos": 0.5}, "gate": "xfail", "phase": "S1", "filter_output": true, "checks": {"must_contain": ["$token"]}, "tags": ["long-line", "grep"], "why": "3 lines of ~300 KB: the newline trigger never fires and the match sits mid-line; the clip must keep the hit"}
{"id": "pytest_buried_failure", "cmd": "python -m pytest -v", "generator": "pytest_buried_failure", "params": {"lines": 5000, "passed": 3366, "failing_test": "tests/test_billing.py::test_invoice_rounding_3366", "summary": "1 failed, 3366 passed, 12 warnings in 240.12s", "warning_lines": 40}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$failing_test", "$summary", "$last_frame"]}, "tags": ["tests", "pytest", "regression-guard"], "why": "one failure in 5,000 lines with the summary 40 lines above the end; today's pytest-aware filter keeps all three fragments (measured 2026-09-04), so S1's clip must not lose them"}
{"id": "tsc_errors", "cmd": "npx tsc --noEmit -p .", "generator": "tsc_errors", "params": {"lines": 300, "crlf": true}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$first", "$last_error"], "must_contain_regex": ["\\[c3_shell:FAIL\\(2\\)\\]"]}, "tags": ["compiler", "crlf"], "why": "300 same-shaped errors with CRLF endings; first and last must survive, exit code named"}
{"id": "npm_build_noise", "cmd": "npm ci && npm run build", "generator": "npm_build_noise", "params": {"lines": 400, "last_line": "added 1234 packages, and audited 1235 packages in 42s"}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$last_line"], "must_contain_regex": ["\\[c3_shell:OK\\]"]}, "tags": ["build", "noise"], "why": "progress and fetch noise around a successful build; the closing line is the signal"}
{"id": "cr_progress_bar", "cmd": "python download.py --model model.bin", "generator": "cr_progress_bar", "params": {"steps": 2000}, "gate": "xfail", "phase": "S2", "filter_output": true, "checks": {"must_contain": ["$final"], "must_not_contain": ["$mid", "\r"]}, "tags": ["progress", "cr"], "why": "one line rewritten 2,000 times with \\r; only the final state means anything"}
{"id": "jsonl_grep", "cmd": "grep corr-9f1e2d3c events.jsonl", "generator": "jsonl_grep", "params": {"hits": 40, "line_bytes": 50000, "key": "correlation_id", "value": "corr-9f1e2d3c"}, "gate": "xfail", "phase": "S1", "filter_output": true, "checks": {"must_contain": ["$key"], "no_marker_inside": "json"}, "tags": ["long-line", "jsonl"], "why": "40 hits of 50 KB JSON each; the matched key must survive and no marker may land inside an object"}
