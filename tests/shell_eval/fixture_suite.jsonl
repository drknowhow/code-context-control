{"id": "tsc_errors", "cmd": "npx tsc --noEmit -p .", "generator": "tsc_errors", "params": {"lines": 300, "crlf": true}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$first", "$last_error"], "must_contain_regex": ["\\[c3_shell:FAIL\\(2\\)\\]"]}, "tags": ["compiler", "crlf"], "why": "300 same-shaped errors with CRLF endings; first and last must survive, exit code named"}
{"id": "npm_build_noise", "cmd": "npm ci && npm run build", "generator": "npm_build_noise", "params": {"lines": 400, "last_line": "added 1234 packages, and audited 1235 packages in 42s"}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$last_line"], "must_contain_regex": ["\\[c3_shell:OK\\]"]}, "tags": ["build", "noise"], "why": "progress and fetch noise around a successful build; the closing line is the signal"}
