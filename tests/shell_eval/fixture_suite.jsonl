{"id": "jsonl_grep", "cmd": "grep corr-9f1e2d3c events.jsonl", "generator": "jsonl_grep", "params": {"hits": 40, "line_bytes": 50000, "key": "correlation_id", "value": "corr-9f1e2d3c"}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$key"], "no_marker_inside": "json"}, "tags": ["long-line", "jsonl"], "why": "40 hits of 50 KB JSON each; the matched key must survive and no marker may land inside an object"}
