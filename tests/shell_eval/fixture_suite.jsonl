{"id": "ansi_cr_progress", "cmd": "pip install ledgerlite", "generator": "ansi_cr_progress", "params": {"steps": 500}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$final", "$done", "[collapsed 499 cr rewrites]"], "must_not_contain": ["$mid", "\r", "\u001b["]}, "tags": ["progress", "cr", "ansi", "s2"], "why": "a coloured bar rewritten 500 times: escapes stripped AND rewrites collapsed on the same line, the plain last line intact"}
