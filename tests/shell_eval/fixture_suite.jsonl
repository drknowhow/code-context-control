{"id": "huge_stderr_empty_stdout", "cmd": "ninja -C build", "generator": "huge_stderr_empty_stdout", "params": {"bytes": 1048576}, "gate": "xfail", "phase": "S1", "filter_output": true, "checks": {"must_contain": ["$tail"]}, "tags": ["stderr", "budget"], "why": "1 MB of linker warnings on stderr, which is never filtered; the final error must survive under budget"}
{"id": "mixed_streams_small", "cmd": "python scripts/check.py", "generator": "mixed_streams_small", "params": {"stdout_lines": 6, "stderr_lines": 2}, "gate": "must_pass", "phase": null, "filter_output": true, "checks": {"must_contain": ["$stdout", "$stderr", "--- stdout ---", "--- stderr ---"], "must_not_contain": ["[stdout filtered]"]}, "tags": ["regression-guard"], "why": "small output on both streams must render verbatim — the shape every short command relies on"}
{"id": "under_budget_120_lines", "cmd": "ls -la /var/log", "generator": "under_budget_120_lines", "params": {"lines": 120}, "gate": "xfail", "phase": "S2", "filter_output": true, "checks": {"must_contain": ["$first", "$middle", "$last"]}, "tags": ["filter-threshold"], "why": "120 plain lines (~6 KB) are well under budget, yet the >30-line heuristic drops the middle"}
