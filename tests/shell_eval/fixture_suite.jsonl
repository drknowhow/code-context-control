{"id": "sed_long_sql_lines", "cmd": "sed -n 1,120p dump.sql", "generator": "sed_long_sql_lines", "params": {"lines": 120, "line_bytes": 8192}, "gate": "xfail", "phase": "S1", "filter_output": true, "checks": {"must_contain": ["$first_prefix"]}, "tags": ["long-line", "budget"], "why": "120 rows of 8 KB each; the first row's prefix must survive under budget"}
